{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "version": {
            "type": "number",
            "description": "PDF version"
        },
        "userPassword": {
            "type": ["string", "null"],
            "description": "Password to open the file"
        },
        "ownerPassword": {
            "type": ["string", "null"],
            "description": "Password to restrict document actions"
        },
        "fileEncryptionKey": {
            "type": ["string", "null"],
            "description": "File encryption key"
        },
        "title": {
            "type": ["string", "null"],
            "description": "Title of the document"
        },
        "producer": {
            "type": ["string", "null"],
            "description": "The software that produced the PDF"
        },
        "author": {
            "type": ["string", "null"],
            "description": "Author of the document"
        },
        "creator": {
            "type": ["string", "null"],
            "description": "Creator of the document"
        },
        "creationDate": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Creation date of the document"
        },
        "modificationDate": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "The last modification date of the document"
        },
        "associatedFiles": {
            "type": "array",
            "description": "An array of objects containing information about associated files",
            "items": {
                "type": "object",
                "properties": {
                    "fileSpecificationString": {
                        "type": "string",
                        "description": "the file specification string"
                    },
                    "embeddedFile": {
                        "type": "object",
                        "description": "Information about the embedded file",
                        "properties": {
                            "length": {
                                "type": "number"
                            },
                            "size": {
                                "type": "number"
                            },
                            "modificationDate": {
                                "type": "string"
                            },
                            "path": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "pages": {
            "type": "array",
            "description": "An array of objects containing information for each page",
            "items": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string",
                        "description": "Text content of the page"
                    },
                    "markdown": {
                        "type": "string",
                        "description": "Text content of the page as markdown"
                    }
                },
                "required": ["content"]
            }
        }
    },
    "required": [
        "version",
        "password",
        "title",
        "producer",
        "author",
        "creator",
        "creationDate",
        "modificationDate",
        "pages"
    ]
}
